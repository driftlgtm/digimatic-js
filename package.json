{
	"name": "digimatic-js",
	"version": "0.1.0",
	"description": "Browser JS library for Mitutoyo Digimatic SPC protocol via Web Serial API",
	"type": "module",
	"main": "./dist/index.cjs",
	"module": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"import": "./dist/index.js",
			"require": "./dist/index.cjs",
			"types": "./dist/index.d.ts"
		}
	},
	"scripts": {
		"build": "tsdown",
		"dev": "tsdown --watch",
		"preview": "pnpx serve ."
	},
	"devDependencies": {
		"@types/w3c-web-serial": "^1.0.8",
		"tsdown": "^0.21.4",
		"typescript": "^5.9.3"
	},
	"keywords": [
		"mitutoyo",
		"digimatic",
		"spc",
		"web-serial",
		"metrology"
	],
	"license": "MIT"
}
