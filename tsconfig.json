{
	"compilerOptions": {
		"target": "ES2022",
		"module": "ESNext",
		"moduleResolution": "bundler",
		"lib": ["ES2022", "DOM"],
		"types": ["w3c-web-serial"],
		"strict": true,
		"noEmit": true,
		"skipLibCheck": true,
		"paths": {
			"@lgtm/digimatic-js": ["./src/index.ts"],
		},
	},
	"include": ["src/**/*", "demo/**/*"],
}
